rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Everything not matched below is denied. Each collection is named on its own: rules add up,
    // so a wildcard over users/{uid} would let any shape through whatever the checks below say.

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Saving needs a verified email. Google accounts arrive verified; email accounts once the
    // player clicks the link. Reading and deleting stay open to the owner, so an account can
    // always be deleted.
    function canSave(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true;
    }

    function validId(value) {
      return value is string && value.size() >= 1 && value.size() <= 40;
    }

    // A field that documents saved before it was added do not have.
    function optionalId(data, key) {
      return !(key in data) || validId(data[key]);
    }

    // A side of a footprint, in inches.
    function validSide(value) {
      return value is number && value >= 0.5 && value <= 36;
    }

    function validFootprint(footprint) {
      return footprint is map
        && footprint.keys().hasOnly(['kind', 'width', 'depth'])
        && footprint.kind in ['rect', 'ellipse']
        && validSide(footprint.width)
        && validSide(footprint.depth);
    }

    function validImageRef(image) {
      return image == null
        || (image is map
          && image.keys().hasOnly(['version', 'ratio'])
          && image.version is int && image.version >= 1
          && image.ratio is number && image.ratio > 0);
    }

    function validPiece(piece) {
      return piece.keys().hasOnly(
          ['name', 'type', 'footprint', 'quantity', 'image', 'schemaVersion', 'createdAt', 'updatedAt'])
        && piece.keys().hasAll(
          ['name', 'type', 'footprint', 'quantity', 'image', 'schemaVersion', 'createdAt', 'updatedAt'])
        && piece.name is string && piece.name.size() >= 1 && piece.name.size() <= 40
        && piece.type in ['ruin', 'building', 'forest', 'obstacle', 'wall', 'hill', 'crater']
        && validFootprint(piece.footprint)
        && piece.quantity is int && piece.quantity >= 1 && piece.quantity <= 20
        && validImageRef(piece.image)
        && piece.schemaVersion == 1
        && piece.updatedAt == request.time;
    }

    // One document per terrain piece in the player's library.
    match /users/{uid}/terrainPieces/{pieceId} {
      allow read, delete: if isOwner(uid);
      allow create: if canSave(uid)
        && validPiece(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if canSave(uid)
        && validPiece(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // One low-resolution photo per terrain piece, at most 150 KB.
    match /users/{uid}/terrainImages/{pieceId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if canSave(uid)
        && request.resource.data.keys().hasOnly(
          ['data', 'mimeType', 'width', 'height', 'ratio', 'updatedAt'])
        && request.resource.data.keys().hasAll(
          ['data', 'mimeType', 'width', 'height', 'ratio', 'updatedAt'])
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 150 * 1024
        && request.resource.data.mimeType in ['image/webp', 'image/jpeg']
        && request.resource.data.width is int
        && request.resource.data.width >= 1 && request.resource.data.width <= 384
        && request.resource.data.height is int
        && request.resource.data.height >= 1 && request.resource.data.height <= 384
        && request.resource.data.ratio is number && request.resource.data.ratio > 0
        && request.resource.data.updatedAt == request.time;
    }

    // The player's game settings: the game and mat a new board starts on, and the balance rules
    // they switched off for each game. Game and mat ids are not listed here, so a new game or mat
    // needs no rules change; the app checks the values when it reads them. The mat is optional:
    // settings saved before mats have none.
    match /users/{uid}/settings/preferences {
      allow read, delete: if isOwner(uid);
      allow create, update: if canSave(uid)
        && request.resource.data.keys().hasOnly(
          ['defaultPresetId', 'rulesOff', 'defaultMatId', 'schemaVersion', 'updatedAt'])
        && request.resource.data.keys().hasAll(
          ['defaultPresetId', 'rulesOff', 'schemaVersion', 'updatedAt'])
        && request.resource.data.defaultPresetId is string
        && request.resource.data.defaultPresetId.size() >= 1
        && request.resource.data.defaultPresetId.size() <= 40
        && request.resource.data.rulesOff is map
        && request.resource.data.rulesOff.size() <= 20
        && optionalId(request.resource.data, 'defaultMatId')
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt == request.time;
    }

    // A board's size, in inches.
    function validBoardSize(board) {
      return board is map
        && board.keys().hasOnly(['width', 'depth'])
        && board.keys().hasAll(['width', 'depth'])
        && board.width is number && board.width > 0 && board.width <= 240
        && board.depth is number && board.depth > 0 && board.depth <= 240;
    }

    // The pieces and placements inside are checked by the app, since rules cannot loop over a
    // list; the lists are capped here so a board stays small.
    function validBoard(board) {
      return board.keys().hasOnly(
          ['name', 'presetId', 'deploymentId', 'board', 'seed', 'generatorVersion', 'enabledRules',
           'pieces', 'placements', 'edited', 'passed', 'matId', 'schemaVersion', 'createdAt',
           'updatedAt'])
        && board.keys().hasAll(
          ['name', 'presetId', 'deploymentId', 'board', 'seed', 'generatorVersion', 'enabledRules',
           'pieces', 'placements', 'edited', 'passed', 'schemaVersion', 'createdAt', 'updatedAt'])
        && board.name is string && board.name.size() >= 1 && board.name.size() <= 60
        && validId(board.presetId)
        && validId(board.deploymentId)
        && validBoardSize(board.board)
        && board.seed is int && board.seed >= 0
        && board.generatorVersion is int && board.generatorVersion >= 1
        && board.enabledRules is list && board.enabledRules.size() <= 6
        && board.pieces is list && board.pieces.size() <= 50
        && board.placements is list && board.placements.size() <= 100
        && board.edited is bool
        && board.passed is bool
        && optionalId(board, 'matId')
        && board.schemaVersion == 1
        && board.updatedAt == request.time;
    }

    // One document per saved board: its layout, its mat (missing on boards saved before mats) and
    // a copy of the terrain it was made from.
    match /users/{uid}/boards/{boardId} {
      allow read, delete: if isOwner(uid);
      allow create: if canSave(uid)
        && validBoard(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if canSave(uid)
        && validBoard(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
