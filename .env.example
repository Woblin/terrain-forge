# Copy to .env.local and fill in values from the Firebase console
# (Project settings -> Your apps). Never commit .env.local.
#
# The values below work with the local emulators (npm run emulators),
# which accept any "demo-" project without a real Firebase project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-terrain-forge.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-terrain-forge
VITE_FIREBASE_STORAGE_BUCKET=demo-terrain-forge.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_USE_EMULATORS=true
